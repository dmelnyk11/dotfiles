# ProtonVPN WireGuard Private Key
# Obtain by generating a WireGuard configuration file at: https://account.proton.me/u/0/vpn/WireGuard
PROTON_PRIVATE_KEY=your_protonvpn_wireguard_private_key_here

# Target VPN Country (defaults to United Kingdom)
SERVER_COUNTRIES=United Kingdom

# Host download & config paths ($HOME is expanded by Docker Compose / shell)
DOWNLOADS_PATH=${HOME}/Downloads/Torrents
CONFIG_PATH=${HOME}/.config/transmission-vpn/config

# Internal control key between gluetun and gluetrans
GLUETUN_API_KEY=secret-key-12345

# Process user/group IDs & Timezone
PUID=1000
PGID=1000
TZ=Europe/London
