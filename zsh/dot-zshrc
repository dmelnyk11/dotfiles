#!/bin/zsh

# Fast exit for AI agents / non-UI automation
if [[ -n "$GEMINI_CLI" || -n "$ANTIGRAVITY_AGENT" ]]; then
  export PS1='$ '
  unset PROMPT_COMMAND
  return
fi

function source_if_exists() {
  if [[ -r "$1" ]]; then
    source "$1"
  fi
}

source_if_exists "$HOME/.zsh/10-options.zsh"
source_if_exists "$HOME/.zsh/20-plugins.zsh"
source_if_exists "$HOME/.zsh/30-alias.zsh"
source_if_exists "$HOME/.zsh/40-interactive.zsh"
